@echo off
setlocal
title AVGN 8-bit for PS Vita - converter
cd /d "%~dp0"
set "AVGN_BAT=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText($env:AVGN_BAT); $i=$s.IndexOf('#AVGN'+'PS'); Invoke-Expression $s.Substring($i)"
echo.
pause
exit /b
#AVGNPS
# ---------------------------------------------------------------------------------------------------------------------
# AVGN 8-bit for PS Vita, version 1.10: converts this game folder's files for the Vita into the folder AVGN8bit.
# Windows PowerShell 5.1 or newer. Native commands are checked with $LASTEXITCODE, not $ErrorActionPreference.
# ---------------------------------------------------------------------------------------------------------------------
$ErrorActionPreference = 'Continue'
$ProgressPreference = 'SilentlyContinue'
$bat = $env:AVGN_BAT
$game = Split-Path -Parent $bat
$out = Join-Path $game 'AVGN8bit'

function Fail($msg) {
    Write-Host ''
    Write-Host ('ERROR: ' + $msg) -ForegroundColor Red
    Write-Host 'Nothing on your Vita was changed. Fix the problem above and run the converter again.'
    exit 1
}
function Step($msg) { Write-Host ''; Write-Host ('== ' + $msg) -ForegroundColor Cyan }

Write-Host 'AVGN 8-bit for PS Vita - converter (1.10)'
Write-Host ('Game folder: ' + $game)
Write-Host 'Keep this window open and do not click inside it while it works (on Windows 10 a click pauses it; press Esc to continue).'

# --- 1. the game files ------------------------------------------------------------------------------------------
Step 'Checking your game files'
$need = @('data.win', 'Silver.ttf', 'LanaPixel.ttf', 'Probly8-CJK.ttf')
foreach ($f in $need) {
    if (-not (Test-Path -LiteralPath (Join-Path $game $f) -PathType Leaf)) {
        Fail ($f + ' is not in this folder. Put AVGN8bit-Vita-Patcher.bat in your AVGN 8 BIT game folder (the one with data.win and AVGN8-Bit.exe; in Steam: right-click the game, Manage, Browse local files) and run it there.')
    }
}
foreach ($d in @('Lang', 'Attract', 'Cutscenes\HD')) {
    if (-not (Test-Path -LiteralPath (Join-Path $game $d) -PathType Container)) { Fail ('The folder ' + $d + ' is missing from the game folder. Let Steam verify the game files and try again.') }
}
$videos = @(Get-ChildItem -LiteralPath (Join-Path $game 'Cutscenes\HD') -Filter '*_1080.mp4' | Sort-Object Name)
if ($videos.Count -ne 6) { Fail ('Cutscenes\HD should have 6 videos, found ' + $videos.Count + '. Let Steam verify the game files and try again.') }
Write-Host 'ok'

# --- 2. ffmpeg (converts the videos) ------------------------------------------------------------------------------
Step 'Finding ffmpeg (it converts the cutscenes)'
function Test-FF($p) {
    if (-not $p -or -not (Test-Path -LiteralPath $p -PathType Leaf)) { return $false }
    try { $t = (& $p -hide_banner -encoders 2>$null | Out-String) + (& $p -hide_banner -h long 2>$null | Out-String) } catch { return $false }
    return ($t -match 'libx264' -and $t -match 'fps_mode')
}
$cache = Join-Path $env:LOCALAPPDATA 'AVGN8bit-Vita-ffmpeg'
$cands = @(Join-Path $game 'ffmpeg.exe')
$cmd = Get-Command ffmpeg.exe -ErrorAction SilentlyContinue | Select-Object -First 1
if ($cmd) { $cands += $cmd.Source }
$cands += @(Get-ChildItem -LiteralPath $cache -Recurse -Filter 'ffmpeg.exe' -ErrorAction SilentlyContinue | ForEach-Object { $_.FullName })
$ff = $null
foreach ($c in $cands) { if (Test-FF $c) { $ff = $c; break } }
if (-not $ff) {
    Write-Host 'No usable ffmpeg on this PC: downloading it once (about 115 MB; nothing moves while it downloads, which can take a few minutes) ...'
    [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
    New-Item -ItemType Directory -Force -Path $cache | Out-Null
    $zip = Join-Path $cache 'ffmpeg.zip'
    $urls = @('https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip',
              'https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-gpl.zip')
    foreach ($u in $urls) {
        try {
            Write-Host ('  from ' + $u)
            (New-Object Net.WebClient).DownloadFile($u, $zip)
            Add-Type -AssemblyName System.IO.Compression.FileSystem
            $dir = Join-Path $cache ([IO.Path]::GetRandomFileName())
            [IO.Compression.ZipFile]::ExtractToDirectory($zip, $dir)
            Remove-Item -LiteralPath $zip -Force -ErrorAction SilentlyContinue
            foreach ($c in @(Get-ChildItem -LiteralPath $dir -Recurse -Filter 'ffmpeg.exe')) { if (Test-FF $c.FullName) { $ff = $c.FullName; break } }
            if ($ff) { break }
        } catch {
            Write-Host ('  that did not work: ' + $_.Exception.Message)
        }
    }
    if (-not $ff) { Fail 'ffmpeg could not be downloaded. Download ffmpeg for Windows yourself (for example ffmpeg-release-essentials.zip from https://www.gyan.dev/ffmpeg/builds/), put ffmpeg.exe in the game folder next to this file, and run it again.' }
}
Write-Host ('ok  ' + $ff)

# --- 3. data.win -> data_vita.win ---------------------------------------------------------------------------------
Step 'Converting data.win for the Vita'
try {
    if (Test-Path -LiteralPath $out) { Remove-Item -LiteralPath $out -Recurse -Force -ErrorAction Stop }
    New-Item -ItemType Directory -Force -Path $out -ErrorAction Stop | Out-Null
} catch {
    Fail ('cannot write the folder ' + $out + ' (' + $_.Exception.Message + '). Copy the whole game folder to your Desktop and run the converter there.')
}
$err = $null
try {
    $all = [IO.File]::ReadAllText($bat)
    $a = $all.IndexOf('<#AVGN' + 'PATCH') + ('<#AVGN' + 'PATCH').Length
    $b = $all.IndexOf('AVGN' + 'PATCH#>')
    $patch = [Convert]::FromBase64String(($all.Substring($a, $b - $a) -replace '\s', ''))
    Add-Type -IgnoreWarnings -ErrorAction Stop -TypeDefinition @'
// The PC patcher's converter (Windows PowerShell compiles this with Add-Type: keep it to C# 5, .NET Framework 4).
// Applies an AVGNDP01 data.win patch (the format of the runtime's data_patch.h) exactly as the Vita does, so the
// result is the same data_vita.win, checked by size and crc32.
using System;
using System.IO;
using System.IO.Compression;

public static class AvgnVitaPatch
{
    static uint[] crcTable;

    static void InitCrc()
    {
        if (crcTable != null) return;
        crcTable = new uint[256];
        for (uint i = 0; i < 256; i++)
        {
            uint c = i;
            for (int k = 0; k < 8; k++) c = (c & 1) != 0 ? 0xEDB88320u ^ (c >> 1) : c >> 1;
            crcTable[i] = c;
        }
    }

    static uint Crc(uint crc, byte[] buf, int off, int len)
    {
        crc = ~crc;
        for (int i = off; i < off + len; i++) crc = crcTable[(crc ^ buf[i]) & 0xff] ^ (crc >> 8);
        return ~crc;
    }

    static ulong Rd64(byte[] b, int o) { return BitConverter.ToUInt64(b, o); }
    static uint Rd32(byte[] b, int o) { return BitConverter.ToUInt32(b, o); }

    static void Progress(ulong done, ulong total, ref int lastPct)
    {
        int pct = total == 0 ? 100 : (int) (done * 100 / total);
        if (pct != lastPct && pct % 5 == 0) { Console.Write("\r    " + pct + "%  "); lastPct = pct; }
    }

    static void ReadExact(Stream s, byte[] buf, int len)
    {
        int got = 0;
        while (got < len)
        {
            int n = s.Read(buf, got, len - got);
            if (n <= 0) throw new InvalidDataException("the patch is damaged");
            got += n;
        }
    }

    // The marker the Vita writes after its own conversion (data_vita.ok): "<size> <crc32 as 8 hex digits>".
    public static string Marker(byte[] patch)
    {
        return Rd64(patch, 20).ToString() + " " + Rd32(patch, 28).ToString("x8");
    }

    // Writes dstPath from srcPath (the stock data.win) and the patch. Returns null on success, else a message.
    public static string Apply(byte[] patch, string srcPath, string dstPath)
    {
        InitCrc();
        if (patch.Length < 42 || System.Text.Encoding.ASCII.GetString(patch, 0, 8) != "AVGNDP01") return "the patch is damaged";
        ulong srcSize = Rd64(patch, 8), dstSize = Rd64(patch, 20);
        uint dstCrc = Rd32(patch, 28);
        if (!File.Exists(srcPath)) return "data.win not found";
        if ((ulong) new FileInfo(srcPath).Length != srcSize) return "data.win is not the supported version of the game (the current Steam version is needed)";

        string part = dstPath + ".part";
        uint crc = 0;
        ulong done = 0;
        int lastPct = -1;
        byte[] buf = new byte[1 << 20];
        try
        {
            // zlib stream: 2-byte header, raw deflate, adler32 (ignored; the result's crc32 is checked instead)
            using (MemoryStream ms = new MemoryStream(patch, 42, patch.Length - 42))
            using (DeflateStream ops = new DeflateStream(ms, CompressionMode.Decompress))
            using (FileStream src = new FileStream(srcPath, FileMode.Open, FileAccess.Read, FileShare.Read, 4096))
            using (FileStream dst = new FileStream(part, FileMode.Create, FileAccess.Write, FileShare.None, 4 << 20))
            {
                byte[] a = new byte[12];
                while (true)
                {
                    ReadExact(ops, a, 1);
                    byte op = a[0];
                    if (op == (byte) 'E') break;
                    if (op == (byte) 'C')
                    {
                        ReadExact(ops, a, 12);
                        ulong off = Rd64(a, 0);
                        uint len = Rd32(a, 8);
                        if (off + len > srcSize) return "the patch is damaged";
                        src.Seek((long) off, SeekOrigin.Begin);
                        while (len > 0)
                        {
                            int n = (int) Math.Min((uint) buf.Length, len);
                            ReadExact(src, buf, n);
                            dst.Write(buf, 0, n);
                            crc = Crc(crc, buf, 0, n);
                            len -= (uint) n;
                            done += (ulong) n;
                            Progress(done, dstSize, ref lastPct);
                        }
                    }
                    else if (op == (byte) 'A')
                    {
                        ReadExact(ops, a, 4);
                        uint len = Rd32(a, 0);
                        while (len > 0)
                        {
                            int n = (int) Math.Min((uint) buf.Length, len);
                            ReadExact(ops, buf, n);
                            dst.Write(buf, 0, n);
                            crc = Crc(crc, buf, 0, n);
                            len -= (uint) n;
                            done += (ulong) n;
                            Progress(done, dstSize, ref lastPct);
                        }
                    }
                    else return "the patch is damaged";
                }
            }
            Console.WriteLine("\r    100%  ");
            if (done != dstSize || crc != dstCrc) return "data.win is not the supported version of the game (the current Steam version is needed)";
            if (File.Exists(dstPath)) File.Delete(dstPath);
            File.Move(part, dstPath);
            return null;
        }
        catch (Exception e)
        {
            return e.Message;
        }
        finally
        {
            if (File.Exists(part)) File.Delete(part);
        }
    }
}
'@
    $err = [AvgnVitaPatch]::Apply($patch, (Join-Path $game 'data.win'), (Join-Path $out 'data_vita.win'))
    if (-not $err) { [IO.File]::WriteAllText((Join-Path $out 'data_vita.ok'), [AvgnVitaPatch]::Marker($patch)) }
} catch {
    $err = 'the converter could not run (' + $_.Exception.Message + '). If your antivirus blocked PowerShell or csc.exe, allow it and run the converter again.'
}
if ($err) { Fail $err }
if (-not (Test-Path -LiteralPath (Join-Path $out 'data_vita.win') -PathType Leaf) -or -not (Test-Path -LiteralPath (Join-Path $out 'data_vita.ok') -PathType Leaf)) { Fail 'data_vita.win could not be written.' }
Write-Host 'ok  data_vita.win (checked)'

# --- 4. fonts, texts, attract mode --------------------------------------------------------------------------------
Step 'Copying fonts, texts and attract-mode data'
try {
    foreach ($f in $need) { if ($f -ne 'data.win') { Copy-Item -LiteralPath (Join-Path $game $f) -Destination $out -ErrorAction Stop } }
    Copy-Item -LiteralPath (Join-Path $game 'Lang') -Destination $out -Recurse -ErrorAction Stop
    Copy-Item -LiteralPath (Join-Path $game 'Attract') -Destination $out -Recurse -ErrorAction Stop
} catch { Fail ('copying the game files into ' + $out + ' failed (' + $_.Exception.Message + ').') }
Write-Host 'ok'

# --- 5. the cutscenes ---------------------------------------------------------------------------------------------
Step 'Converting the cutscenes for the Vita (the longest step: about 5-20 minutes; do not click inside this window)'
$hd = Join-Path $out 'Cutscenes\HD'
New-Item -ItemType Directory -Force -Path $hd | Out-Null
$n = 0
foreach ($v in $videos) {
    $n++
    Write-Host ('  ' + $n + '/6  ' + $v.Name)
    $dst = Join-Path $hd $v.Name
    $tmp = $dst + '.tmp.mp4'
    $ffargs = @('-hide_banner', '-loglevel', 'error', '-stats', '-nostdin', '-y', '-i', $v.FullName,
              '-map', '0:v:0', '-map', '0:a:0', '-map_metadata', '-1', '-map_chapters', '-1', '-sn', '-dn',
              '-vf', 'scale=960:544:flags=lanczos,setsar=1,format=yuv420p', '-fps_mode', 'cfr', '-r', '24',
              '-c:v', 'libx264', '-preset', 'slow', '-tune', 'animation', '-crf', '20', '-profile:v', 'baseline', '-level:v', '3.1',
              '-x264-params', 'ref=4:keyint=120:min-keyint=24', '-maxrate', '5M', '-bufsize', '10M')
    if ($v.Name -like '*ending*') { $ffargs += @('-force_key_frames', '115.33') }
    $ffargs += @('-bsf:v', 'filter_units=remove_types=6',
               '-colorspace', 'bt709', '-color_primaries', 'bt709', '-color_trc', 'bt709', '-color_range', 'tv',
               '-af', 'volume=-1.5dB', '-c:a', 'aac', '-b:a', '160k', '-ar', '48000', '-ac', '2',
               '-video_track_timescale', '1000', '-movflags', '+faststart', $tmp)
    & $ff @ffargs
    if ($LASTEXITCODE -ne 0 -or -not (Test-Path -LiteralPath $tmp)) { Fail ('converting ' + $v.Name + ' failed (ffmpeg exit code ' + $LASTEXITCODE + ').') }
    try { Move-Item -LiteralPath $tmp -Destination $dst -Force -ErrorAction Stop } catch { Fail ('saving ' + $dst + ' failed (' + $_.Exception.Message + ').') }
}
Write-Host 'ok'

# --- done -----------------------------------------------------------------------------------------------------------
$mb = [int]((Get-ChildItem -LiteralPath $out -Recurse -File | Measure-Object -Property Length -Sum).Sum / 1MB)
Write-Host ''
Write-Host '======================================================================================' -ForegroundColor Green
Write-Host (' Done. The folder for your Vita is: ' + $out + '  (' + $mb + ' MB)') -ForegroundColor Green
Write-Host ''
Write-Host ' 1. Connect the Vita with VitaShell (press Select for USB mode, or use FTP).'
Write-Host ' 2. Copy the whole folder AVGN8bit into ux0:data/  (so you get ux0:data/AVGN8bit/data_vita.win).'
Write-Host ' 3. Install AVGN8bit-Vita-1.10.vpk with VitaShell and start the game.'
Write-Host '======================================================================================' -ForegroundColor Green
exit 0
